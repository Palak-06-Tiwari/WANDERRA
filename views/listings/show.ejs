<% layout('layouts/boilerplate') %>
<body>
    <div class="row mt-3">
     <div class="col-8 offset-3 ">
    <h3>Listing details:</h3>
    </div>
    <div class="card  col-6 offset-3 show-card">
        <img class="card-img-top show-img" src="<%=listing.image.url%>" alt="Listing Image">
  <div class="card-body">
    <p class="card-text">
        <b><%=listing.title%></b> <br/>
        <b>Description:</b> <%=listing.description%> <br/>
        <b>Price:</b> &#8377; <%=listing.price.toLocaleString("en-IN")%> <br/>
        <b>Location:</b> <%=listing.location%> <br/>
        <b>Country:</b> <%=listing.country%> <br/>
    </p>
  </div>
    </div>
    <br/> 
    </div>
      <div class="btns">
   <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>
     <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
        <button class="btn btn-dark offset-5 delete-btn">
          Delete
        </button>
    </form>
   </div>
</body>
